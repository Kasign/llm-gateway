# 仅用于 DeepSeek/OpenAI 示例之外的额外远程 Provider。
# Compose 会把本文件单独注入 Gateway；不要把主 .env 全量复制到这里。
# 示例均为注释，不会默认创建或启用 Provider。将 EXAMPLE 替换成自己唯一的 Provider ID。
#
# LLM_GATEWAY_PROVIDER_EXAMPLE_ENABLED=true
# LLM_GATEWAY_PROVIDER_EXAMPLE_BASE_URL=https://api.example.com/v1
# LLM_GATEWAY_PROVIDER_EXAMPLE_API_KEY=replace-with-real-provider-key
# LLM_GATEWAY_PROVIDER_EXAMPLE_API_KEY_HEADER=Authorization
# LLM_GATEWAY_PROVIDER_EXAMPLE_DEFAULT_MODEL=example-model
# LLM_GATEWAY_PROVIDER_EXAMPLE_MAX_CONCURRENT_REQUESTS=8
# LLM_GATEWAY_PROVIDER_EXAMPLE_REQUEST_TIMEOUT_SECONDS=0
# LLM_GATEWAY_PROVIDER_EXAMPLE_MAX_RESPONSE_BYTES=0
# LLM_GATEWAY_PROVIDER_EXAMPLE_ALLOW_INSECURE_HTTP=false
# LLM_GATEWAY_PROVIDER_EXAMPLE_ALLOW_PRIVATE_NETWORK=false
# 可选 JSON 对象：公开模型 ID -> 上游真实模型 ID。
# LLM_GATEWAY_PROVIDER_EXAMPLE_MODEL_MAPPINGS_JSON={"public-chat":"vendor-chat","public-reasoner":"vendor-reasoner"}
#
# 配置提示：
# 1. 0 的 request timeout 不设 Provider 级整体时限；慢速本地模型可用 0。
# 2. 私网地址与 HTTP 默认禁止，只有确认上游可信时才显式打开。
# 3. ID 转小写后必须与 YAML、其他环境变量及 Web Provider 保持唯一。
