# 现有 llama.cpp / Redis / MariaDB 所在的 Docker network。
EXISTING_DOCKER_NETWORK=CHANGE_ME

# 既有数据库/Redis 在上述 Docker network 内的容器地址；须与实际容器名一致。
# Compose 对旧 .env 缺少这两个变量的部署提供兼容默认值。
LLM_GATEWAY_DB_HOST=Mariadb
LLM_GATEWAY_REDIS_ADDR=Redis:6379

# 空库第一次启动时 /v1 走哪个上游：llamacpp 或 ollama。管理台切换后以数据库为准。
LLM_BACKEND=llamacpp
# llama.cpp 在 Docker 网内的地址。主机名必须与容器名一致。
LLAMA_CPP_BASE_URL=http://Llama-cpp:8080
# Ollama 在 Docker 网内的地址。必须和上面不同。
OLLAMA_BASE_URL=http://ollama:11434
# 可选：仅当 llama.cpp 进程本身启用了 --api-key 时填写（与管理密钥、调用方 API Key 无关）
LLAMA_UPSTREAM_API_KEY=
# 本地 llama.cpp / Ollama 推理整体时限；0 不设整体时限，适合慢速本地模型。正整数限制秒数，最大 604800。
LLAMA_REQUEST_TIMEOUT_SECONDS=0

# 部署托管的远程 Provider API Key。不要把真实密钥提交到 Git。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Web 管理台新增的 Provider Key 使用 AES-256-GCM 加密后写入数据库。
# 生成：openssl rand -base64 32。配置后必须备份；更换密钥会导致旧密文无法解密。
LLM_GATEWAY_PROVIDER_ENCRYPTION_KEY=

# 由 .env 预置的 Provider 在 Web 管理台只读显示。不要再在 config.yaml 重复定义相同 ID。
LLM_GATEWAY_PROVIDER_DEEPSEEK_ENABLED=true
LLM_GATEWAY_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_GATEWAY_PROVIDER_DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
LLM_GATEWAY_PROVIDER_DEEPSEEK_API_KEY_HEADER=Authorization
LLM_GATEWAY_PROVIDER_DEEPSEEK_DEFAULT_MODEL=deepseek-chat
LLM_GATEWAY_PROVIDER_DEEPSEEK_ALLOW_INSECURE_HTTP=false
LLM_GATEWAY_PROVIDER_DEEPSEEK_ALLOW_PRIVATE_NETWORK=false
LLM_GATEWAY_PROVIDER_DEEPSEEK_MAX_CONCURRENT_REQUESTS=64
# 0 关闭排队并沿用立即返回 503 的行为；正数设置最多排队请求数（上限 1024）。
LLM_GATEWAY_PROVIDER_DEEPSEEK_MAX_QUEUE_SIZE=0
# 队列等待超时秒数；0 使用默认 30 秒，上限 3600 秒。
LLM_GATEWAY_PROVIDER_DEEPSEEK_QUEUE_WAIT_TIMEOUT_SECONDS=30
# 0 关闭 Provider 级 RPM；正数限制该 Provider 的 UTC 固定分钟窗口请求数。
LLM_GATEWAY_PROVIDER_DEEPSEEK_REQUESTS_PER_MINUTE=0
# 每日 Token 预算（UTC）；0 关闭，正数设置该 Provider 的每日 Token 上限。
LLM_GATEWAY_PROVIDER_DEEPSEEK_TOKEN_BUDGET_PER_DAY=0
# 0 使用默认响应体上限；正数按字节数限制。
LLM_GATEWAY_PROVIDER_DEEPSEEK_MAX_RESPONSE_BYTES=0
# 0 不额外限制完整请求时长；1–86400 秒限制完整 JSON/SSE 请求。
LLM_GATEWAY_PROVIDER_DEEPSEEK_REQUEST_TIMEOUT_SECONDS=0
# 可选 JSON 对象：公开模型 ID -> 供应商真实模型 ID。
# LLM_GATEWAY_PROVIDER_DEEPSEEK_MODEL_MAPPINGS_JSON={"public-chat":"deepseek-chat","public-reasoner":"deepseek-reasoner"}

LLM_GATEWAY_PROVIDER_OPENAI_ENABLED=true
LLM_GATEWAY_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_GATEWAY_PROVIDER_OPENAI_API_KEY=${OPENAI_API_KEY}
LLM_GATEWAY_PROVIDER_OPENAI_API_KEY_HEADER=Authorization
LLM_GATEWAY_PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4.1
LLM_GATEWAY_PROVIDER_OPENAI_ALLOW_INSECURE_HTTP=false
LLM_GATEWAY_PROVIDER_OPENAI_ALLOW_PRIVATE_NETWORK=false
LLM_GATEWAY_PROVIDER_OPENAI_MAX_CONCURRENT_REQUESTS=64
LLM_GATEWAY_PROVIDER_OPENAI_MAX_QUEUE_SIZE=0
LLM_GATEWAY_PROVIDER_OPENAI_QUEUE_WAIT_TIMEOUT_SECONDS=30
LLM_GATEWAY_PROVIDER_OPENAI_REQUESTS_PER_MINUTE=0
LLM_GATEWAY_PROVIDER_OPENAI_TOKEN_BUDGET_PER_DAY=0
LLM_GATEWAY_PROVIDER_OPENAI_MAX_RESPONSE_BYTES=0
LLM_GATEWAY_PROVIDER_OPENAI_REQUEST_TIMEOUT_SECONDS=0
# LLM_GATEWAY_PROVIDER_OPENAI_MODEL_MAPPINGS_JSON={"public-chat":"gpt-4.1","public-reasoner":"o3"}

# Gateway 与现有 llama.cpp 共用的宿主机模型目录。
# 必须填写你实际存放 GGUF 的宿主机目录。
MODEL_HOST_DIR=/server-whl/docker/llm-models

# 现有 MariaDB 管理员账号密码。
# 该账号仅用于 Gateway 首次启动时自动创建数据库、用户和授权。
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Gateway 专用 MariaDB 账号密码。
# Gateway 首次启动会自动创建/更新该账号。
LLM_GATEWAY_DB_PASSWORD=CHANGE_ME

# Gateway 管理 API 密钥。
# 用于访问 /api/admin/*，请生成一个足够长的随机字符串。
LLM_GATEWAY_ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_KEY

# Web 控制台默认密码为 999888777；部署后建议立即更换。
# 新哈希使用 pbkdf2: 冒号分隔格式，避免 Compose 将 $ 当作变量插值。
LLM_GATEWAY_ADMIN_PASSWORD_HASH=pbkdf2:120000:NPQtPMgg+xqbAp04ObNRnA:J9q8Ggs9XtRIZ1E6Fb6Q9anZ0wcYPz/5zFX26GfrZjQ
# 仅影响数据库尚未保存账号设置时的初始状态；数据库中的设置页保存值始终优先。
LLM_GATEWAY_WEB_PASSWORD_ENABLED=true

# 现有 Redis 密码（与 config.yaml 中 redis.password 对应）。
REDIS_ROOT_PASSWORD=
